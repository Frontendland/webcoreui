---
import ComponentWrapper from '@static/ComponentWrapper.astro'
import Layout from '@static/Layout.astro'

import AstroRadioGroup from '@blocks/RadioGroup/RadioGroup.astro'
import SvelteRadioGroup from '@blocks/RadioGroup/RadioGroup.svelte'
import ReactRadioGroup from '@blocks/RadioGroup/RadioGroup.tsx'

import { getSections } from '@helpers'
import { checkboxGroup } from '@data'

const sections = getSections({
    title: 'radio groups',
    components: [AstroRadioGroup, SvelteRadioGroup, ReactRadioGroup]
})
---

<Layout>
    <h1>RadioGroup</h1>
    <div class="grid md-2 lg-3">
        <ComponentWrapper type="Astro">
            <AstroRadioGroup items={checkboxGroup} name="astro-radio-group" />
        </ComponentWrapper>

        <ComponentWrapper type="Svelte">
            <SvelteRadioGroup items={checkboxGroup} name="svelte-radio-group" />
        </ComponentWrapper>

        <ComponentWrapper type="React">
            <ReactRadioGroup items={checkboxGroup} name="react-radio-group" />
        </ComponentWrapper>
    </div>

    {sections.map(section => (
        <h1>{section.title}</h1>
        <Fragment>
            {section.subTitle && <h2 set:html={section.subTitle} />}
        </Fragment>
        <div class="grid md-2">
            <ComponentWrapper title="Default">
                <section.component
                    items={checkboxGroup}
                    name={`default-${section.type}`}
                />
            </ComponentWrapper>

            <ComponentWrapper title="No icon">
                <section.component
                    items={checkboxGroup.map(item => ({ ...item, icon: '' }))}
                    name={`no-icon-${section.type}`}
                />
            </ComponentWrapper>

            <ComponentWrapper title="Primary cards">
                <section.component
                    name={`primary-${section.type}`}
                    items={checkboxGroup}
                    secondary={false}
                    flat={false}
                />
            </ComponentWrapper>

            <ComponentWrapper title="Secondary cards">
                <section.component
                    name={`secondary-${section.type}`}
                    items={checkboxGroup}
                    flat={false}
                />
            </ComponentWrapper>

            <ComponentWrapper title="Three column layout" className="full">
                <section.component
                    name={`columns-${section.type}`}
                    items={checkboxGroup}
                    columns={3}
                />
            </ComponentWrapper>
        </div>
    ))}
</Layout>

<style lang="scss" is:global>
    @use 'webcoreui/config' as *;

    .full {
        grid-column: 1 / -1;
    }
</style>

<script>
    import { listen } from 'webcoreui'

    listen('radioGroupOnChange', event => {
        // eslint-disable-next-line no-console
        console.log(event)
    })
</script>
