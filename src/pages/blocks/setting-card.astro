---
import { Button, Checkbox, Switch } from 'webcoreui/astro'

import Layout from '@static/Layout.astro'

import Card from '@components/Card/Card.astro'

import AstroSettingCard from '@blocks/SettingCard/SettingCard.astro'
import SvelteSettingCard from '@blocks/SettingCard/SettingCard.svelte'
import ReactSettingCard from '@blocks/SettingCard/SettingCard.tsx'

import warning from '../../icons/warning.svg?raw'

import { getSections } from '@helpers'

const sections = getSections({
    title: 'setting cards',
    components: [AstroSettingCard, SvelteSettingCard, ReactSettingCard]
})
---

<Layout docs="/blocks/setting-card">
    <h1>Setting Card Blocks</h1>
    <h2>
        <a href="/blocks">
            {'<-'} Back to all blocks
        </a>
    </h2>

    <div class="grid xs-2 sm-3">
        <Card title="Setting cards" bodyClassName="flex column sm">
            <AstroSettingCard
                title="Security emails"
                subTitle="Get security alerts for logins."
            >
                <Switch toggled={true} />
            </AstroSettingCard>
            <AstroSettingCard
                title="Marketing emails"
                subTitle="Get email about updates."
            >
                <Switch />
            </AstroSettingCard>
        </Card>

        <Card title="Svelte setting cards" bodyClassName="flex column sm">
            <SvelteSettingCard
                title="Security emails"
                subTitle="Get security alerts for logins."
            >
                <Checkbox checked={true} />
            </SvelteSettingCard>
            <SvelteSettingCard
                title="Marketing emails"
                subTitle="Get email about updates."
            >
                <Checkbox />
            </SvelteSettingCard>
        </Card>

        <Card title="React setting cards" bodyClassName="flex column sm">
            <ReactSettingCard title="Security emails">
                <Button className="toggle">Toggle off</Button>
            </ReactSettingCard>
            <ReactSettingCard
                title="Marketing emails"
                subTitle="Get email about updates."
            >
                <Button className="toggle" theme="secondary">Toggle on</Button>
            </ReactSettingCard>
        </Card>
    </div>

    {sections.map((section: any) => (
        <br />
        <h2>{section.title}</h2>
        <div class="grid sm-2">
            <Card title="With additional content">
                <section.component
                    title="Security emails"
                    subTitle="Get security alerts for logins."
                >
                    <Switch toggled={true} />
                    {section.type === 'svelte' ? (
                        <div slot="additionalContent" class="flex column xs">
                            <Checkbox label="Server alerts" />
                            <Checkbox label="Client alerts" />
                        </div>
                    ) : (
                        <div slot="additional-content" class="flex column xs">
                            <Checkbox label="Server alerts" />
                            <Checkbox label="Client alerts" />
                        </div>
                    )}
                </section.component>
            </Card>

            <Card title="With icon">
                <section.component
                    title="Security emails"
                    subTitle="Get security alerts for logins."
                    icon={warning}
                >
                    <Switch toggled={true} />
                </section.component>
            </Card>
        </div>
    ))}
</Layout>

<style lang="scss">
    @use 'webcoreui/config' as *;

    .toggle {
        @include typography(md);
        @include spacing(py-xs, px-sm);
    }
</style>
